                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="btnGuardarCambios" layoutX="211.0" layoutY="434.0" mnemonicParsing="false" onAction="#editarUniversidad" prefHeight="40.0" prefWidth="156.0" styleClass="button-principal" text="Guardar cambios" textFill="WHITE" />
            <Button fx:id="btnCancelar" layoutX="409.0" layoutY="434.0" mnemonicParsing="false" onAction="#cancelarEdicion" prefHeight="40.0" prefWidth="100.0" styleClass="button-secundario" text="Cancelar" />

            <Text fx:id="Titulo" layoutX="18.0" layoutY="51.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Configuración de universidad">
               <font>
                  <Font name="Franklin Gothic Demi" size="40.0" />
               </font>
            </Text>
            <Text layoutX="18.0" layoutY="131.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre">
               <font>
                  <Font name="Franklin Gothic Book" size="25.0" />
               </font>
            </Text>
            <Text layoutX="21.0" layoutY="264.0" strokeType="OUTSIDE" strokeWidth="0.0" text="País">
               <font>
                  <Font name="Franklin Gothic Book" size="25.0" />
               </font>
            </Text>
            <TextField fx:id="tfNombre" layoutX="19.0" layoutY="152.0" onKeyTyped="#limitarCaracteres" prefHeight="50.0" prefWidth="508.0" promptText="Nombre de la institución universitaria">

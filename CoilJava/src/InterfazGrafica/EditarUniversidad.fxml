<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="389.0" prefWidth="504.0" styleClass="root" stylesheets="@Recursos/EstiloVentanas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InterfazGrafica.EditarUniversidadControlador">
   <children>
      <Text fx:id="Titulo" layoutX="44.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Configuración de universidadDTO">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Text>
      <Text layoutX="25.0" layoutY="116.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <Text layoutX="26.0" layoutY="232.0" strokeType="OUTSIDE" strokeWidth="0.0" text="País">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <TextField fx:id="tfNombre" layoutX="26.0" layoutY="129.0" onKeyTyped="#limitarCaracteres" prefHeight="40.0" prefWidth="462.0" promptText="Nombre de la institución universitaria" />
      <ComboBox fx:id="cmbPaises" layoutX="26.0" layoutY="245.0" prefHeight="40.0" prefWidth="462.0" />
      <Label fx:id="txtObligatorioNombre" layoutX="106.0" layoutY="99.0" text="*Campo obligatorio" textFill="RED" visible="false" />
      <Label fx:id="txtObligatorioPais" layoutX="68.0" layoutY="215.0" text="*Campo obligatorio" textFill="RED" visible="false" />
      <Button fx:id="btnGuardarCambios" layoutX="262.0" layoutY="344.0" mnemonicParsing="false" onAction="#editarUniversidad" styleClass="button-principal" text="Guardar cambios" textFill="WHITE" />
      <Button fx:id="btnCancelar" layoutX="415.0" layoutY="344.0" mnemonicParsing="false" onAction="#cancelarEdicion" styleClass="button-secundario" text="Cancelar" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="759.0" prefWidth="973.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InterfazGrafica.EnvioPropuestaControlador">
   <children>
      <Label layoutX="42.0" layoutY="30.0" prefHeight="71.0" prefWidth="898.0" styleClass="label-titulo" text="Propuesta de colaboración">
         <font>
            <Font name="Arial Rounded MT Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="95.0" layoutY="170.0" text="Tema de interés">
         <font>
            <Font name="Arial" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="tfTemaInteres" layoutX="313.0" layoutY="160.0" prefHeight="43.0" prefWidth="619.0" promptText="Ingresa el tema de interés" styleClass="label-inicioSesion-naranja">
         <font>
            <Font size="18.0" />
         </font></TextField>
      <Label layoutX="95.0" layoutY="224.0" text="Objetivo">
         <font>
            <Font name="Arial" size="20.0" />
         </font>
      </Label>
      <TextArea fx:id="taObjetivo" layoutX="313.0" layoutY="224.0" prefHeight="152.0" prefWidth="619.0" promptText="Ingresa el objetivo de la colaboración" styleClass="label-inicioSesion-rosado">
         <font>
            <Font size="18.0" />
         </font></TextArea>
      <Button fx:id="btnEnviar" layoutX="664.0" layoutY="443.0" mnemonicParsing="false" onAction="#enviarPropuestaColaboracion" prefHeight="50.0" prefWidth="118.0" styleClass="button-principal" text="Enviar" />
      <Button fx:id="btnCancelar" layoutX="825.0" layoutY="443.0" mnemonicParsing="false" onAction="#cancelarEnvioPropuesta" prefHeight="50.0" prefWidth="106.0" styleClass="button-secundario" text="Cancelar" />
   </children>
   <stylesheets>
      <URL value="@Recursos/EstiloLabels.css" />
      <URL value="@Recursos/EstiloVentanas.css" />
   </stylesheets>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="49.0" prefWidth="791.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InterfazGrafica.CuentaItemControlador">
   <children>
      <HBox prefHeight="49.0" prefWidth="791.0">
         <children>
            <Label fx:id="lbUsuario" alignment="CENTER" contentDisplay="TOP" prefHeight="41.0" prefWidth="66.0" text="\@Usuario">
               <cursor>
                  <Cursor fx:constant="W_RESIZE" />
               </cursor>
            </Label>
            <Label fx:id="lbNombre" alignment="CENTER" prefHeight="46.0" prefWidth="94.0" text="\@Nombre" />
            <Label fx:id="lbApellidos" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="108.0" text="\@Apellidos" />
            <Label fx:id="lbCorreo" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="123.0" text="\@Correo" />
            <Label fx:id="lbUniversidad" alignment="CENTER" prefHeight="50.0" prefWidth="122.0" text="\@Universidad" />
            <Label fx:id="lbPais" alignment="CENTER" prefHeight="50.0" prefWidth="54.0" text="\@Pais" />
            <Label fx:id="lbCedula" alignment="CENTER" prefHeight="54.0" prefWidth="118.0" text="\@Cedúla profesional" />
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="95.0">
               <children>
                  <Button fx:id="btEvaluar" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="26.0" prefWidth="77.0" text="Evaluar" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" />
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
</VBox>

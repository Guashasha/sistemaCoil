      <HBox prefHeight="49.0" prefWidth="791.0">
         <children>
            <Label fx:id="lbUsuario" alignment="CENTER" contentDisplay="CENTER" prefHeight="48.0" prefWidth="66.0" text="\@Usuario">
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor>
            </Label>
            <Label fx:id="lbNombre" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="94.0" text="\@Nombre" />
            <Label fx:id="lbApellidos" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="108.0" text="\@Apellidos" />
            <Label fx:id="lbCorreo" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="123.0" text="\@Correo" />
            <Label fx:id="lbUniversidad" alignment="CENTER" contentDisplay="CENTER" prefHeight="50.0" prefWidth="129.0" text="\@Universidad" />
            <Label fx:id="lbPais" alignment="CENTER" contentDisplay="CENTER" prefHeight="50.0" prefWidth="89.0" text="\@Pais" />

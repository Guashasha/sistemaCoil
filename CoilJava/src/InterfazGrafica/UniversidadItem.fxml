<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="51.0" prefWidth="913.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InterfazGrafica.UniversidadItemControlador">
   <children>
      <Label fx:id="lbUniversidad" alignment="CENTER" prefHeight="51.0" prefWidth="493.0">
         <font>
            <Font name="Corbel" size="20.0" />
         </font>
      </Label>
      <Label fx:id="lbPais" alignment="CENTER" prefHeight="51.0" prefWidth="290.0">
         <font>
            <Font name="Corbel" size="20.0" />
         </font>
      </Label>
      <BorderPane prefHeight="70.0" prefWidth="158.0">
         <center>
            <Button fx:id="btnEditar" alignment="TOP_LEFT" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#editarUniversidad" prefHeight="32.0" prefWidth="22.0" style="-fx-background-color: E7C736;" BorderPane.alignment="CENTER">
               <graphic>
                  <ImageView fitHeight="24.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@Recursos/edit.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </center>
      </BorderPane>
   </children>
   <padding>
      <Insets top="10.0" />
   </padding>
</HBox>
